{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SottoASR",
  "version": "0.7.4",
  "identifier": "com.sottoasr.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:14517",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: data:; connect-src 'self' ipc: tauri: asset: https://asset.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "Developer ID Application: Juan Villa (DR3FNR9MW9)"
    },
    "resources": ["sidecar/"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE4Rjg2OEU5NjZEMkE0QkIKUldTN3BOSm02V2o0cURNRGpLTGhqd3UxaXVDNUdBMnlyaGNDdExacFpEWkFjNGY5WWN4V1Jtd3cK",
      "endpoints": [
        "https://github.com/juanqui/sottoasr/releases/latest/download/latest.json"
      ]
    }
  }

}
