{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SottoASR",
  "version": "0.2.4",
  "identifier": "com.sottoasr.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:14517",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: https://asset.localhost data:; connect-src 'self' ipc: tauri: asset: https://asset.localhost"
    },
    "trayIcon": {
      "id": "main-tray",
      "iconPath": "icons/tray-iconTemplate.png",
      "iconAsTemplate": true,
      "menuOnLeftClick": true,
      "tooltip": "SottoASR — Speech to Text"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "Developer ID Application: Juan Villa (DR3FNR9MW9)"
    },
    "resources": ["sidecar/"]
  },
  "plugins": {}

}
