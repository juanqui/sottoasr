+    // MARK: - Pinned Revisions
+
+    /// Commits used instead of `main`, keyed by upstream repository path. The
+    /// application verifies the files it loads against a manifest of these commits.
+    static let pinnedRevisions: [String: String] = [
+        "FluidInference/parakeet-ultra-coreml": "95eaa59a39d4394f047a4dc5cce480388a60d1b6",
+        "FluidInference/parakeet-ctc-110m-coreml": "accdafd8cf8a2ff1cabe3c11e54416b405d409aa",
+    ]
+
+    /// The commit to read from `repoPath` in place of the mutable `main`. The
+    /// repository's own revision stays `main`, so the cache keeps every file it
+    /// finds: a pinned SDK revision would delete files it does not list.
+    static func pinned(_ revision: String, for repoPath: String) -> String {
+        revision == "main" ? pinnedRevisions[repoPath] ?? revision : revision
+    }
